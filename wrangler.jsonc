{
  "name": "worker-ai-gateway",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  // nodejs_compat：在 Workers 中提供 node: 内置模块（如 node:crypto）
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "GATEWAY_KV",
      "id": "f38a6f58d85c4689bbab062d0ed4c842"
    }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 13 * * *"
    ]
  }
}