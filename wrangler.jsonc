{
  "name": "worker-ai-gateway",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  // qwenweb 反爬移植用 node:crypto（AES-CBC/PKCS7 + sha256/md5），需此 flag 才能在 Workers 运行
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "GATEWAY_KV",
      "id": "f38a6f58d85c4689bbab062d0ed4c842"
    }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 13 * * *"
    ]
  }
}