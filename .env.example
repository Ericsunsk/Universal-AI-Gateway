# ===================================================================
# Universal AI Gateway - Environment Variables Template
# ===================================================================
#
# 1. 复制此文件为 .env.local:
#    cp .env.example .env.local
#
# 2. 填入真实凭证（.env.local 已在 .gitignore 中，不会提交到版本控制）
#
# 3. 生成强随机密钥：
#    openssl rand -hex 32
# ===================================================================

# -------------------- 网关核心密钥 --------------------
# 客户端 API Key（供 Claude Code / CC-Switch / Cursor 调用）
API_KEY="sk-your-client-key-here"

# 管理主密钥（访问 /usage、/checkin 等管理端点）
# ⚠️ 必须与 API_KEY 不同，使用强随机值
# 生成方式: openssl rand -hex 32
MASTER_KEY="your-master-key-must-be-different-from-api-key"

# Cron 定时任务密钥（可选，用于外部 cron 触发）
# 不设置时 Vercel Cron 内建触发器无需密钥
CRON_SECRET=""

# -------------------- WorkBuddy CN 凭证 --------------------
# 腾讯云代码助手（中国站）账号信息
# 获取方式: https://github.com/Ericsunsk/Universal-AI-Gateway#q-如何获取腾讯云代码助手的-token-和-user-id
USER_ID=""
ACCESS_TOKEN=""
REFRESH_TOKEN=""

# -------------------- WorkBuddy International 凭证 --------------------
# CodeBuddy.ai（国际站）账号信息（可选）
# 留空则不启用国际站 provider
INTL_USER_ID=""
INTL_ACCESS_TOKEN=""
INTL_REFRESH_TOKEN=""

# -------------------- KV 存储配置 --------------------
# Upstash Redis / Vercel KV（可选）
# 不配置时使用纯内存缓存（单实例有效）
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_TIMEOUT_MS="5000"

# 兼容别名（与上方二选一）
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# -------------------- 高级选项 --------------------
# 上下文剪枝：保留最近 N 轮对话（0 = 不剪枝，默认）
MAX_CONTEXT_TURNS="0"

# 重试延迟基础值（毫秒，默认 600）
RETRY_BASE_MS="600"

# -------------------- Vercel 自动注入（无需手动设置） --------------------
# VERCEL_URL="your-project.vercel.app"
# VERCEL_PROJECT_DOMAINS='["domain1.com","domain2.com"]'
# VERCEL_OIDC_TOKEN="<vercel-internal-token>"
