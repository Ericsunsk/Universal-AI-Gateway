{
  "version": 2,
  "installCommand": "npm install --omit=dev --ignore-scripts",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/checkin",
      "schedule": "0 1 * * *"
    }
  ]
}
