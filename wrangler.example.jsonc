{
  "name": "worker-ai-gateway",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "kv_namespaces": [
    {
      "binding": "WORKBUDDY_KV",
      "id": "your-cloudflare-kv-namespace-id"
    }
  ],
  "triggers": {
    "crons": ["0 1 * * *", "0 13 * * *"]
  },
  "vars": {
    "API_KEY": "sk-your-gateway-api-key",
    "MASTER_KEY": "admin-secret-key",
    "USER_ID": "your-workbuddy-user-id",
    "ACCESS_TOKEN": "",
    "REFRESH_TOKEN": ""
  }
}
